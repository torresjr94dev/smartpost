# ═══════════════════════════════════════════════════════════
# SmartPost Admin — Variables de entorno requeridas
# Copia este archivo a .env.local y rellena los valores
# NUNCA commitear .env.local al repositorio
# ═══════════════════════════════════════════════════════════

# ── Base de datos ──────────────────────────────────────────
# Misma DB que usa n8n en el VPS
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/smartpost"

# ── NextAuth ───────────────────────────────────────────────
# Genera con: openssl rand -base64 32
NEXTAUTH_SECRET="tu_secret_aqui_generalo_con_openssl"
NEXTAUTH_URL="https://app.tudominio.com"   # En dev: http://localhost:3000

# ── Meta (Facebook + Instagram) ───────────────────────────
# En Meta for Developers → Tu App → Configuración básica
META_APP_ID="tu_facebook_app_id"
META_APP_SECRET="tu_facebook_app_secret"
META_CALLBACK_URL="https://app.tudominio.com/api/auth/callback/facebook"
# En dev:
# META_CALLBACK_URL="http://localhost:3000/api/auth/callback/facebook"

# ── LinkedIn ───────────────────────────────────────────────
# En LinkedIn Developers → Tu App → Auth
LINKEDIN_CLIENT_ID="tu_linkedin_client_id"
LINKEDIN_CLIENT_SECRET="tu_linkedin_client_secret"
LINKEDIN_CALLBACK_URL="https://app.tudominio.com/api/auth/callback/linkedin"
# En dev:
# LINKEDIN_CALLBACK_URL="http://localhost:3000/api/auth/callback/linkedin"

# ── Stripe ─────────────────────────────────────────────────
# NUNCA usar sk_test en producción
STRIPE_SECRET_KEY="sk_live_..."
# Para verificar webhooks: stripe listen --forward-to localhost:3000/api/webhooks/stripe
STRIPE_WEBHOOK_SECRET="whsec_..."
# IDs de precios en Stripe → Productos → tu plan → Precio → API ID
# Producto "SmartPost Basic":
#   - Precio mensual: $29 USD/month  ($228/year = $19/mes × 12)
STRIPE_PRICE_ID_BASIC_MONTHLY="price_..."
STRIPE_PRICE_ID_BASIC_ANNUAL="price_..."
# Producto "SmartPost Pro":
#   - Precio mensual: $69 USD/month  ($588/year = $49/mes × 12)
STRIPE_PRICE_ID_PRO_MONTHLY="price_..."
STRIPE_PRICE_ID_PRO_ANNUAL="price_..."

# ── Encriptación de tokens ─────────────────────────────────
# Genera con: openssl rand -hex 32
# MISMA clave que debes configurar en n8n como variable de entorno
TOKEN_ENCRYPTION_KEY="64_caracteres_hex_aqui_genera_con_openssl_rand_hex_32"

# ── n8n (opcional — para disparar workflows desde el admin) ──
N8N_API_KEY="tu_n8n_api_key"
N8N_BASE_URL="https://n8n.tudominio.com"

# ── WhatsApp Business ──────────────────────────────────────
# Solo necesario si el admin necesita enviar mensajes directamente
WHATSAPP_ACCESS_TOKEN="tu_whatsapp_access_token"
WHATSAPP_PHONE_NUMBER_ID="tu_phone_number_id"
